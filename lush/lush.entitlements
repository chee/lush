<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.device-discovery.pairing-access</key>
	<string>default</string>
	<key>com.apple.developer.maps</key>
	<true/>
	<key>com.apple.developer.weatherkit</key>
	<true/>
	<key>com.apple.developer.wifi-aware</key>
	<array>
		<string>Subscribe</string>
		<string>Publish</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.party.chee.patchwork.lush</string>
	</array>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.temporary-exception.apple-events</key>
	<array>
		<string>com.apple.notes</string>
	</array>
</dict>
</plist>
